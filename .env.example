# URL base da API do backend (Node/Express).
# O código em src/services/api.ts já usa esse valor por padrão.
VITE_API_URL=http://localhost:3001/api

# Usado apenas pela integração opcional com Google Forms/Drive
# (src/lib/googleAuth.ts, src/config/firebase.ts).
# Não é necessário para o fluxo principal (login/forms/questions/etc via backend próprio).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
